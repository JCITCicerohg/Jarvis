{
  "name": "kb-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@duckdb/node-api": "^1.5.5-r.5",
    "@huggingface/transformers": "^3.8.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "docx": "^9.8.1",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
