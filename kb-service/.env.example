DATABASE_URL=postgres://kb:kb@localhost:5433/kb
PORT=8790
BLOB_DIR=data/blobs
# name:key pairs, comma separated. Jarvis uses one of these keys.
KB_API_KEYS=owner:change-me
# name:key pairs for /v1/admin (cutover, rollback, builds)
KB_ADMIN_KEYS=
# Planner model: anthropic (default, claude-haiku-4-5), openai (default gpt-5-mini) or azure (KB_LLM_MODEL = deployment name)
KB_LLM_PROVIDER=anthropic
KB_LLM_MODEL=
# Embeddings: local (default, free, bge-small downloaded once from Hugging Face), openai, or azure (an Azure deployment of text-embedding-3-small)
KB_EMBED_PROVIDER=local
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Azure OpenAI (TiroAI), e.g. https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBED_DEPLOYMENT=
# Azure app registration for kb-service (app-only, Sites.Selected)
KB_MS_TENANT_ID=
KB_MS_CLIENT_ID=
KB_MS_CLIENT_SECRET=
SYNC_MINUTES=5
