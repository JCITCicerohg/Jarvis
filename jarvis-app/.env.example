# Optional: the app's setup screen stores the key for you. This is a fallback.
ANTHROPIC_API_KEY=
PORT=8787

# Microsoft 365 (Outlook, Teams, SharePoint/OneDrive) — see README "Microsoft 365 setup"
MS_CLIENT_ID=
MS_TENANT_ID=

# Browser engine: msedge (default), chrome, or chromium; 1 hides the window
JARVIS_BROWSER_CHANNEL=msedge
JARVIS_BROWSER_HEADLESS=0

# Knowledge base (kb-service). The key is one of the service's KB_API_KEYS.
KB_API_URL=http://localhost:8790
KB_API_KEY=
